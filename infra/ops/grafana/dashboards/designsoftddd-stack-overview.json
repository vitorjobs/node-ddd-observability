      "targets": [
        {
          "expr": "sum(otelcol_exporter_queue_size)",
          "refId": "A"
        }
      ],
      "title": "Collector Queue Size",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Falhas por segundo do Prometheus ao enviar metricas para o Mimir. O esperado e zero.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "id": 4,
      "options": {
        "colorMode": "value",
