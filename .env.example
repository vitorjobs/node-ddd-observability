PORT=3333
NODE_ENV=development
LOG_LEVEL=debug
APP_LOG_LEVEL=info

OTEL_SERVICE_NAME=rocketseat-ddd-api
OTEL_SERVICE_NAMESPACE=designsoftddd
OTEL_RESOURCE_ATTRIBUTES=service.namespace=designsoftddd,deployment.environment.name=development,service.version=1.0.0
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
